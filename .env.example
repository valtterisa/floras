# =============================================================================
# Floras — environment template
# Copy to `.env.local`:  cp .env.example .env.local
# `pnpm dev:convex` / `npx convex dev` will fill NEXT_PUBLIC_CONVEX_URL +
# CONVEX_DEPLOYMENT automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js (.env.local)
# Generation, Box, publish, and Autumn run in Next.js API routes — not Convex.
# -----------------------------------------------------------------------------

# Public site URL for SEO (canonical, Open Graph, sitemap, robots)
# e.g. https://floras.ai
NEXT_PUBLIC_APP_URL=

# Convex client URL (required)
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment name, e.g. "dev:happy-animal-123"
CONVEX_DEPLOYMENT=

# Autumn billing (app/api/autumn/[...all] + credit / plan checks)
AUTUMN_SECRET_KEY=
# Production fails closed when Autumn is down. Set to 1 only for emergencies.
# BILLING_FAIL_OPEN=1

# Anthropic (site generation / agent — Pro plan platform key)
ANTHROPIC_API_KEY=

# Encrypts user BYOK Anthropic keys at rest (use a long random secret, 32+ chars). Next.js only.
BYOK_ENCRYPTION_SECRET=

# Optional default model id (claude-sonnet-5 | claude-opus-4-8 | claude-fable-5)
# AGENT_MODEL=claude-sonnet-5

# box.ascii.dev sandboxes (preview + in-box build/deploy)
BOX_API_KEY=
# BOX_BASE_URL=https://ascii.dev/api/box/v1
# Stopped template Box to fork for each new project (required).
BOX_GOLDEN_BOX_ID=

# Cloudflare Pages (publish + custom domains)
# Token scopes (User API Token):
#   Account → Cloudflare Pages → Edit
#   Zone → DNS → Edit  (floras.app zone — Pages has no wildcard domains)
#   Account → Email Sending → Edit  (form notification emails; or use CLOUDFLARE_EMAIL_API_TOKEN)
# Do NOT put these in Box Dashboard → Secrets (user Boxes are noEnv).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Zone ID for floras.app (Overview → API section / right sidebar)
CLOUDFLARE_ZONE_ID=

# Optional dedicated token for Email Sending if the Pages token lacks that scope
# CLOUDFLARE_EMAIL_API_TOKEN=
# From-address after onboarding floras.app in Cloudflare Email Service → Email Sending
EMAIL_FROM=Floras <noreply@floras.app>

# Published site host: {32-char-id}.floras.app
FLORAS_SITES_DOMAIN=floras.app

# Optional: isolate cloud coding agents from your personal Convex deployment
# CONVEX_AGENT_MODE=anonymous

# -----------------------------------------------------------------------------
# Convex deployment env (set with: npx convex env set KEY value)
# Auth / email only — not Anthropic, Box, Autumn, or Cloudflare.
# -----------------------------------------------------------------------------

# Convex Auth — provision once with: npx @convex-dev/auth
# JWT_PRIVATE_KEY=
# JWKS=
# SITE_URL=http://localhost:3000

# Google OAuth (Convex Auth) — set on the Convex deployment, not Next.js:
# npx convex env set AUTH_GOOGLE_ID <client-id>
# npx convex env set AUTH_GOOGLE_SECRET <client-secret>
# Google Cloud redirect URI: {CONVEX_SITE_URL}/api/auth/callback/google

# Usually set automatically by Convex
# CONVEX_SITE_URL=

# Magic links via Resend
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Floras <onboarding@resend.dev>
