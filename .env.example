# =============================================================================
# Floras — environment template
# Copy to `.env.local`:  cp .env.example .env.local
# `pnpm dev:convex` / `npx convex dev` fills NEXT_PUBLIC_CONVEX_URL +
# CONVEX_DEPLOYMENT automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js (.env.local)
# Generation, Blaxel, publish, and Autumn run in Next.js API routes — not Convex.
# -----------------------------------------------------------------------------

# Public site URL for SEO (canonical, Open Graph, sitemap, robots).
# Must match the host that serves the site (sitemap URLs must share that host).
# e.g. https://floras.app
NEXT_PUBLIC_APP_URL=

# Convex client URL (required)
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment name, e.g. "dev:happy-animal-123"
CONVEX_DEPLOYMENT=


# Autumn billing (app/api/autumn/[...all] + credit / plan checks)
AUTUMN_SECRET_KEY=
# Fail-open only when explicitly set. Local NODE_ENV=development also fail-opens
# unless VERCEL_ENV=production.
# BILLING_FAIL_OPEN=1

# Anthropic (site generation / agent — Pro plan platform key)
ANTHROPIC_API_KEY=

# Encrypts user BYOK Anthropic keys at rest (use a long random secret, 32+ chars)
BYOK_ENCRYPTION_SECRET=

# Optional default model id (claude-sonnet-5 | claude-opus-4-8 | claude-fable-5)
# AGENT_MODEL=claude-sonnet-5

# Blaxel sandboxes (preview + in-sandbox build)
BL_API_KEY=
BL_WORKSPACE=
# Astro template Git repo cloned into each new sandbox when no R2 snapshot exists
BL_TEMPLATE_REPO=
# BL_TEMPLATE_REF=main
# BL_TEMPLATE_GITHUB_TOKEN=
# BL_SANDBOX_IMAGE=blaxel/node:latest
# BL_SANDBOX_REGION=eu-lon-1
# BL_SANDBOX_MEMORY_MB=4096
# BL_SANDBOX_IDLE_TTL=60d
# BL_SANDBOX_IDLE_TTL=off
# BL_SITE_ROOT=/app
# BL_PREVIEW_PORT=4321
# DEBUG_SANDBOX=1

# Cloudflare Pages + DNS (publish + custom domains)
# Token scopes (User API Token):
#   Account → Cloudflare Pages → Edit
#   Zone → DNS → Edit  (floras.app)
#   Account → Email Sending → Edit  (or use CLOUDFLARE_EMAIL_API_TOKEN)
# Publish uploads from Next.js only — never inject these into the sandbox.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=Floras <noreply@floras.app>

# Published site host: {id}.floras.app
FLORAS_SITES_DOMAIN=floras.app

# CONVEX_AGENT_MODE=anonymous

# -----------------------------------------------------------------------------
# Convex deployment env (set with: npx convex env set KEY value)
# Auth + R2 — not Anthropic / Blaxel / Autumn / Pages tokens.
# -----------------------------------------------------------------------------

# Convex Auth — provision once with: npx @convex-dev/auth
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=http://localhost:3000

# Google OAuth (Convex Auth)
# Redirect URI: {CONVEX_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

CONVEX_SITE_URL=

# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Floras <onboarding@resend.dev>

R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_TOKEN=
